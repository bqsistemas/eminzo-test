{
  "name": "eminzo-test",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.11.0"
  },
  "scripts": {
    "dev:server": "node --watch src/server/main.ts",
    "dev:web": "vite",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "build": "vite build && tsc -p tsconfig.server.json",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:browser": "playwright test",
    "browser:install": "playwright install chromium"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
